--- /dev/null
+++ b/src/carto_flow/flow_cartogram/step_scale.py
@@ -0,0 +1,138 @@
+"""Per-step velocity scale of the GSM family (experiment, see the exploration-gsm-scale page).
+
+GSM moves each vertex with ``v / rho(x, t)`` along the density path ``rho(x, t) = (1 - t) rho0(x) + t rho_mean``.
+"""
+
+import numpy as np
+from numba import njit
+
+MODES = (
+    "constant",
+    "gsm_normalized",
+    "gsm_physical",
+    "integral_normalized",
+    "integral_physical",
+    "integral_oneshot",
+)
+
+
+@njit(cache=True, fastmath=True)
+def max_scaled_abs(vx, vy, rho0, t, rho_mean, floor):
+    """max(|vx f|, |vy f|) over the grid for f = rho_mean / max(rho(x, t), floor rho_mean)."""
+    lo = floor * rho_mean
+    m = 0.0
+    for i in range(vx.shape[0]):
+        for j in range(vx.shape[1]):
+            r = max((1.0 - t) * rho0[i, j] + t * rho_mean, lo)
+            f = rho_mean / r
+            a = max(abs(vx[i, j]), abs(vy[i, j])) * f
+            if a > m:
+                m = a
+    return m
+
+
+@njit(cache=True, fastmath=True)
+def scaled_field(vx, vy, rho0, t, rho_mean, floor):
+    """Grid fields v * rho_mean / max(rho(x, t), floor rho_mean) and their max abs component."""
+    lo = floor * rho_mean
+    wx = np.empty_like(vx)
+    wy = np.empty_like(vy)
+    m = 0.0
+    for i in range(vx.shape[0]):
+        for j in range(vx.shape[1]):
+            r = max((1.0 - t) * rho0[i, j] + t * rho_mean, lo)
+            f = rho_mean / r
+            wx[i, j] = vx[i, j] * f
+            wy[i, j] = vy[i, j] * f
+            a = max(abs(wx[i, j]), abs(wy[i, j]))
+            if a > m:
+                m = a
+    return wx, wy, m
+
+
+def integral_field(vx, vy, rho0, rho_mean, floor):
+    """Grid fields v * rho_mean * int_0^1 dt / rho(x, t) = v * ln(rho_mean/rho0)/(rho_mean - rho0) * rho_mean."""
+    r = np.maximum(rho0 / rho_mean, floor)
+    u = 1.0 - r
+    small = np.abs(u) < 1e-4
+    safe = np.where(small, 1.0, u)
+    g = np.where(small, 1.0 + u / 2 + u * u / 3, -np.log(r) / safe)
+    return vx * g, vy * g
+
+
+@njit(cache=True, fastmath=True)
+def displace_scaled(coords, x_coords, y_coords, vx, vy, rho0, c, dx, dy, t, rho_mean, floor, use_ratio, max_disp):
+    """Displace vertices by interp(v) * c, times rho_mean / rho(x, t) if ``use_ratio`` (rho0 interpolated).
+
+    The displacement length is capped at ``max_disp`` if it is positive.
+    """
+    n = coords.shape[0]
+    out = coords.copy()
+    dx_inv = 1.0 / dx
+    dy_inv = 1.0 / dy
+    x_min = x_coords[0]
+    y_min = y_coords[0]
+    max_ix = vx.shape[1] - 2
+    max_iy = vx.shape[0] - 2
+    lo = floor * rho_mean
+    for i in range(n):
+        x = coords[i, 0]
+        y = coords[i, 1]
+        ix = max(0, min(int((x - x_min) * dx_inv), max_ix))
+        iy = max(0, min(int((y - y_min) * dy_inv), max_iy))
+        tx = (x - x_coords[ix]) * dx_inv
+        ty = (y - y_coords[iy]) * dy_inv
+        w00 = (1.0 - tx) * (1.0 - ty)
+        w10 = tx * (1.0 - ty)
+        w01 = (1.0 - tx) * ty
+        w11 = tx * ty
+        ux = w00 * vx[iy, ix] + w10 * vx[iy, ix + 1] + w01 * vx[iy + 1, ix] + w11 * vx[iy + 1, ix + 1]
+        uy = w00 * vy[iy, ix] + w10 * vy[iy, ix + 1] + w01 * vy[iy + 1, ix] + w11 * vy[iy + 1, ix + 1]
+        s = c
+        if use_ratio:
+            r0 = w00 * rho0[iy, ix] + w10 * rho0[iy, ix + 1] + w01 * rho0[iy + 1, ix] + w11 * rho0[iy + 1, ix + 1]
+            s = c * rho_mean / max((1.0 - t) * r0 + t * rho_mean, lo)
+        ux *= s
+        uy *= s
+        if max_disp > 0.0:
+            d = np.sqrt(ux * ux + uy * uy)
+            if d > max_disp:
+                ux *= max_disp / d
+                uy *= max_disp / d
+        out[i, 0] += ux
+        out[i, 1] += uy
+    return out
+
+
+MEASURE = []  # mean displacement per step in cells, filled when not None
+MEASURE_ON = False
+
+
+@njit(cache=True, fastmath=True)
+def vertex_means(coords, x_coords, y_coords, vx, vy, rho0, t, rho_mean, floor):
+    """Mean over the vertices of |v| and of |v| rho_mean / rho(x, t) (bilinear interpolation)."""
+    dx_inv = 1.0 / (x_coords[1] - x_coords[0])
+    dy_inv = 1.0 / (y_coords[1] - y_coords[0])
+    max_ix = vx.shape[1] - 2
+    max_iy = vx.shape[0] - 2
+    lo = floor * rho_mean
+    sa = 0.0
+    sb = 0.0
+    for i in range(coords.shape[0]):
+        x = coords[i, 0]
+        y = coords[i, 1]
+        ix = max(0, min(int((x - x_coords[0]) * dx_inv), max_ix))
+        iy = max(0, min(int((y - y_coords[0]) * dy_inv), max_iy))
+        tx = (x - x_coords[ix]) * dx_inv
+        ty = (y - y_coords[iy]) * dy_inv
+        w00 = (1.0 - tx) * (1.0 - ty)
+        w10 = tx * (1.0 - ty)
+        w01 = (1.0 - tx) * ty
+        w11 = tx * ty
+        ux = w00 * vx[iy, ix] + w10 * vx[iy, ix + 1] + w01 * vx[iy + 1, ix] + w11 * vx[iy + 1, ix + 1]
+        uy = w00 * vy[iy, ix] + w10 * vy[iy, ix + 1] + w01 * vy[iy + 1, ix] + w11 * vy[iy + 1, ix + 1]
+        r0 = w00 * rho0[iy, ix] + w10 * rho0[iy, ix + 1] + w01 * rho0[iy + 1, ix] + w11 * rho0[iy + 1, ix + 1]
+        a = np.sqrt(ux * ux + uy * uy)
+        sa += a
+        sb += a * rho_mean / max((1.0 - t) * r0 + t * rho_mean, lo)
+    return sa / coords.shape[0], sb / coords.shape[0]
